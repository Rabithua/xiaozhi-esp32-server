# Copy to .env, keep it private (chmod 600), and fill every blank value.
# Use three distinct random passwords. Never commit the completed file.
DB_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=

# Absolute path outside the checkout, on a persistent local or external disk.
# This path holds uploads/ and server-data/.config.yaml; create both directories.
STATE_DIR=

# Only this Mac can connect by default. LAN device access is an explicit step.
WEB_BIND_IP=127.0.0.1
COMPOSE_PROJECT_NAME=xiaozhi-mac

# Images default to the ARM64 digests in compose.yaml and image-lock.json.
# Optional overrides: MYSQL_IMAGE, REDIS_IMAGE, WEB_IMAGE, SERVER_IMAGE.
# API/model credentials belong in the private management database, not here.
